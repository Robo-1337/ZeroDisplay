#include <windows.h>

1 RT_MANIFEST "app.manifest"
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CC_VERSION_NUM
 PRODUCTVERSION CC_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ZeroDisplay, low-latency capture"
            VALUE "FileVersion", CC_VERSION_STR
            VALUE "ProductName", "ZeroDisplay"
            VALUE "ProductVersion", CC_VERSION_STR
            VALUE "OriginalFilename", "ZeroDisplay.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
